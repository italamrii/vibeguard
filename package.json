{
  "name": "@italamrii/vibeguard",
  "version": "0.1.0",
  "description": "Local, read-only static scanner for security flaws common in AI-generated (vibe-coded) Next.js, React and Node apps on Supabase/Firebase.",
  "license": "Apache-2.0",
  "author": "italamrii",
  "homepage": "https://github.com/italamrii/vibeguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italamrii/vibeguard.git"
  },
  "bugs": {
    "url": "https://github.com/italamrii/vibeguard/issues"
  },
  "keywords": [
    "security",
    "sast",
    "static-analysis",
    "supabase",
    "row-level-security",
    "rls",
    "nextjs",
    "react",
    "express",
    "fastify",
    "firebase",
    "secrets",
    "sarif",
    "cli",
    "vibe-coding"
  ],
  "type": "module",
  "bin": {
    "vibeguard": "dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./schema/findings.v1.schema.json": "./schema/findings.v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "accuracy": "tsx scripts/accuracy.ts",
    "arabic-review": "tsx scripts/arabic-review.ts",
    "sarif:check": "tsx scripts/validate-sarif.ts",
    "scan:history": "tsx scripts/scan-history.ts",
    "docs:rules": "tsx scripts/rule-docs.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "pack:check": "tsx scripts/check-pack.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "14.0.3",
    "ignore": "7.0.5",
    "libpg-query": "18.2.2",
    "picocolors": "1.1.1",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
